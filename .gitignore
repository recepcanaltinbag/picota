/picota/bacteria_xeno_proteins
/bacteria_xeno_proteins
/merged
/DBs/
# Exclude the databases but walk into the tree, because git will not re-include
# a file whose parent directory is itself excluded.
/picota/DBs/*
!/picota/DBs/ISes/
/picota/DBs/ISes/*
# Track the generated ISFinder taxonomy TSV (small, derived from IS.fna)
!/picota/DBs/ISes/isfinder_taxonomy.tsv
